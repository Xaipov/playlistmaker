<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:layout_marginTop="@dimen/screen_padding"
        android:paddingStart="16dp"
        android:textColor="@color/whitecard"
        android:textSize="22sp"
        android:fontFamily="@font/ys_text_medium"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/SearchCard"
        style="@style/MainButton"
        android:text="@string/search"
        app:icon="@drawable/search"
        app:iconGravity="textStart"
        app:iconTint="@color/blacktext" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/medialibraryCard"
        style="@style/MainButton"
        android:text="@string/medialibrary"
        app:icon="@drawable/library_music_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
        app:iconGravity="textStart"
        app:iconTint="@color/blacktext" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/SettingsCard"
        style="@style/MainButton"
        android:text="@string/settings"
        app:icon="@drawable/settings_24dp"
        app:iconGravity="textStart"
        app:iconTint="@color/blacktext" />


</LinearLayout>
